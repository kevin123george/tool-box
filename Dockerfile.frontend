FROM oven/bun:1
WORKDIR /app

# Copy only package.json first (for caching)
COPY frontend/package.json ./

RUN bun install --production

# Copy rest of the app
COPY frontend/ .

# Build TS → JS
RUN bun build src/server.ts --outdir dist

ENV NODE_ENV=production

EXPOSE 3000
CMD ["bun", "dist/server.js"]