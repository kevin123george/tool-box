# Frontend Dockerfile using Bun
FROM oven/bun:1

WORKDIR /app

# Copy package.json
COPY toolbox-frontend/package.json ./

# Install dependencies - package.json has no dependencies, so this is a no-op
# The || true is safe here as there are intentionally no dependencies to install
RUN bun install || true

# Copy source code
COPY toolbox-frontend/src ./src
COPY toolbox-frontend/public ./public

# Expose port
EXPOSE 3000

# Run the server
CMD ["bun", "run", "src/server.ts"]
