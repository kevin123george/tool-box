# Frontend Dockerfile using Bun
FROM oven/bun:1

WORKDIR /app

# Copy package.json
COPY toolbox-frontend/package.json ./

# Install dependencies - package.json has no dependencies listed, so this is effectively a no-op
RUN bun install

# Copy source code
COPY toolbox-frontend/src ./src
COPY toolbox-frontend/public ./public

# Expose port
EXPOSE 3000

# Run the server
CMD ["bun", "run", "src/server.ts"]
