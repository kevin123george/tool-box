# Ignore git files
.git
.gitignore

# Ignore gradle build artifacts EXCEPT build/libs which we need
.gradle/
build/*
!build/libs/

# Ignore IDE files
.idea/
.vscode/
*.iml

# Ignore logs
*.log
logs/

# Ignore test files
src/test/

# Ignore temporary files
tmp/
temp/
*.tmp

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore documentation (except for README and DOCKER.md)
*.md
!README.md
!DOCKER.md

# Environment files
.env
.env.*

# Node modules
node_modules/
