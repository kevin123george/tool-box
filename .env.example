# Copy this file to .env and fill in your values

# Auth
JWT_SECRET=change_me_to_a_long_random_hex_string

# Default user (created on first startup)
KEVIN_NAME=Admin
KEVIN_EMAIL=admin@example.com
KEVIN_PASSWORD=changeme

# APIs (optional — features degrade gracefully without these)
ALPHA_VANTAGE_API_KEY=

# MailerSend email notifications (optional)
# Sign up at https://app.mailersend.com — free tier: 3,000 emails/month
MAILERSEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_FROM_NAME=ToolBox
